#
# Phase-2 Sprint-6 Tag-11 — Quadlet volume sidecar for the SPIRE-
# Server Admin-API gRPC socket-share. Mirror of compose/spire.yaml
# top-level volumes.spire_server_sockets.name.
#
# Install path: /etc/containers/systemd/wakir-spire-server-sockets.volume
# (rootful) or ~/.config/containers/systemd/ (rootless).
#
# This unit is referenced by:
#   - wakir-spire-server.container via the directive
#     `Volume=wakir-spire-server-sockets.volume:/run/spire/sockets`.
#   - wakir-spire-agent.container via the same directive — both units
#     mount this volume at the same path so that the Admin-API gRPC
#     channel (Server <-> Agent) is established via a Unix-socket on
#     the shared volume.
#
# This is the shared-volume channel for Server <-> Agent gRPC; the
# Workload-API socket-share is on the dedicated
# `wakir-spire-agent-sockets.volume`.

[Unit]
Description=Wakir SPIRE-Server Admin-API socket-share volume (Quadlet dual-track)

[Volume]
# Mirror of compose volumes.spire_server_sockets.name. Same name string
# so `podman volume ls` shows wakir-spire-server-sockets regardless of
# which lifecycle path created it.
VolumeName=wakir-spire-server-sockets

[Install]
WantedBy=multi-user.target default.target
