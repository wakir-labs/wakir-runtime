#
# Tag-22 Mini-Welle — Operations-Reife — Phase-3b Rust-CLI binary
# installer oneshot Quadlet unit (retry after Tag-21 quota-hit; no
# substance change, identical bytes-shape as the Tag-21 draft).
#
# Tag-24 Mini-Welle update (ADR-0065 Phase-3c Trigger-Gate 3)
# -----------------------------------------------------------
# Inventory extended from 5 to 7 binaries in lock-step with the
# Cosign-Policy Tag-24 update (Trigger-Gate 2). Added
# ``subscribe-loop`` (Tag-22 PR #181 wired switch) and
# ``anchor-emitter`` (Tag-23 PR #184 wired switch). The
# cross-substrate parity test
# (test_cross_substrate_parity_with_quadlet_installer) enforces
# lock-step agreement with the Cosign-Policy YAML.
#
# Tag-29 Mini-Welle update (ADR-0066 Welle-2 image-build)
# -------------------------------------------------------
# Inventory extended from 7 to 8 binaries in lock-step with the
# Cosign-Policy Tag-29 update. One addition:
# ``svid-workload-identity`` (Tag-25 Mini-Welle PR #191 wired the
# resolver — Selin's resolver recording ``binary_missing`` as the
# Welle-2 precondition signal; Tag-29 ships the crate substrate
# closing that precondition). The cross-substrate parity test
# (test_cross_substrate_parity_with_quadlet_installer) enforces
# lock-step agreement with the Cosign-Policy YAML.
#
# Tag-33 Mini-Welle update (ADR-0066 Welle-4-7 image-build bundle)
# ----------------------------------------------------------------
# Inventory extended from 9 to 13 binaries in lock-step with the
# Cosign-Policy Tag-33 update. Four additions in a single Mini-Welle
# bundle — dedicated single-binary images for the Welle-4..7
# cutover steps (the carrier image at the bottom of this Quadlet
# unit continues to ship the same nine binaries; the four Tag-33
# additions are pinned by the Welle-4..7 cutover steps INDEPENDENTLY
# of this Quadlet via dedicated per-Welle Quadlets that the cutover
# Mini-Wellen will land):
#
#   * ``wakir-persona-engine-state-backing-welle4`` (Tag-33 Welle-4)
#   * ``wakir-persona-engine-fsm-welle5`` (Tag-33 Welle-5, the
#     `lifecycle-state-machine` substrate)
#   * ``wakir-persona-engine-subscribe-loop-welle6`` (Tag-33 Welle-6)
#   * ``wakir-persona-engine-recovery-welle7`` (Tag-33 Welle-7, the
#     `recovery-workflow` substrate)
#
# Same Sigstore-keyless-OIDC verification pattern as the prior nine
# binaries; the cross-substrate parity test
# (test_cross_substrate_parity_with_quadlet_installer) enforces
# lock-step agreement with the Cosign-Policy YAML. The Exec= line
# below does NOT install the four Tag-33 single-binary additions —
# those are deployed via per-Welle dedicated Quadlets in the
# Welle-4..7 cutover Mini-Wellen.
#
# Tag-45 Mini-Welle update (Phase-3a-Foundation 14 + 15 closeout)
# ----------------------------------------------------------------
# Inventory extended from 9 to 11 carrier-image binaries in lock-step
# with the Cosign-Policy Tag-45 update (13 -> 15 with the four
# Welle-4..7 dedicated single-binary images unchanged). Two additions
# in a single Mini-Welle bundle — both Phase-3a-Foundation closeout
# modules from Reza's 15-module sweep:
#
#   * ``bridge-audit-replay`` (Tag-37 Mini-Welle PR #246 — 14. Phase-3a
#     Modul; deterministic-replay-oracle from ADR-0063 §Folgeartefakte
#     Item 11. Binary lives in the same
#     ``persona-engine-bridge-audit-replay`` crate as the existing
#     bridge-audit-writer; the Tag-45 Mini-Welle promotes the
#     canonical-trace surface to the
#     /opt/wakir/bin/wakir-persona-engine-bridge-audit-replay path.)
#   * ``migrate-version`` (Tag-38 Mini-Welle PR #250 — 15. Phase-3a
#     Modul; engine-version migration pre-flight decision
#     canonical-trace. New stand-alone canonical-only crate
#     persona-engine-migrate-version. Ships at
#     /opt/wakir/bin/wakir-persona-engine-migrate-version.)
#
# Same Sigstore-keyless-OIDC verification pattern as the prior nine.
# Both bridges are CANONICAL-only (no live state-backing I/O on the
# Rust side; the Python sibling holds the live workflow). The
# cross-substrate parity test
# (test_cross_substrate_parity_with_quadlet_installer) enforces
# lock-step agreement with the Cosign-Policy YAML.
#
# Tag-31 Mini-Welle update (ADR-0066 Welle-3 image-build)
# -------------------------------------------------------
# Inventory extended from 8 to 9 binaries in lock-step with the
# Cosign-Policy Tag-31 update. One addition:
# ``bridge-audit-writer`` (Tag-31 Mini-Welle, ADR-0066 Welle-3
# pre-cutover image — ships the writer-half of the Doppelbetrieb-
# Shadow EngineeringOutputEvent envelope substrate. The replay-half
# (PR #131 bridge-diff + PR #147 bridge-audit-replay) already shipped;
# Tag-31 closes the cross-language round-trip Python↔Rust). The
# cross-substrate parity test
# (test_cross_substrate_parity_with_quadlet_installer) enforces
# lock-step agreement with the Cosign-Policy YAML.
#
# Purpose
# -------
# Installs the nine Phase-3b Rust-CLI binaries from the published
# ``ghcr.io/wakir-labs/wakir-persona-engine`` carrier image (Tag-17
# through Tag-23 + Tag-29 + Tag-31 Mini-Welle PRs #167, #169, #171,
# #175, #181, #184 + the Tag-29 SVID-image-build PR + the Tag-31
# bridge-audit-writer image-build PR) into the Pilot-VM host
# filesystem at the canonical ``/opt/wakir/bin/`` paths. The default
# ``DEFAULT_RUST_*_BIN`` constants in
# ``wirelang/persona_engine/rust_backend_switch.py`` resolve to
# these exact paths, so any host-side consumer (Operator-Hand
# recovery-drill scripts, future systemd oneshots that pre-resolve
# state-backing fences, host-shell probes) finds the same byte-
# identical binaries that the in-container persona-engine bridges
# to.
#
# Eleven binaries installed (alphabetical by component)
# ------------------------------------------------------
#   1. /opt/wakir/bin/wakir-persona-engine-anchor-emitter
#      (Tag-23 Mini-Welle PR #184 — WAT-anchor-envelope emitter bridge;
#      Cosign-Policy 7-binary inventory landed lock-step in Tag-24.)
#   2. /opt/wakir/bin/wakir-persona-engine-bridge-audit-replay
#      (Tag-37 Mini-Welle PR #246 — Phase-3a-Foundation 14. Modul;
#      deterministic-replay-oracle canonical-trace bridge. Tag-45
#      Mini-Welle promotes the canonical-trace surface to this path
#      lock-step with the Cosign-Policy 15-binary inventory.)
#   3. /opt/wakir/bin/wakir-persona-engine-bridge-audit-writer
#      (Tag-31 Mini-Welle — Doppelbetrieb-Shadow EngineeringOutputEvent
#      envelope writer bridge; Cosign-Policy 9-binary inventory landed
#      lock-step in Tag-31.)
#   4. /opt/wakir/bin/wakir-persona-engine-bridge-diff
#      (Tag-20 Mini-Welle PR #175 — Doppelbetrieb diff oracle;
#      Cosign-Policy 5-binary inventory landed lock-step in Tag-23.)
#   5. /opt/wakir/bin/wakir-persona-engine-fsm
#      (Tag-18 Mini-Welle PR #169 — lifecycle FSM bridge)
#   6. /opt/wakir/bin/wakir-persona-engine-migrate-version
#      (Tag-38 Mini-Welle PR #250 — Phase-3a-Foundation 15. Modul;
#      engine-version migration pre-flight decision canonical-trace.
#      Closes the Phase-3a-Foundation sweep at 15/15.)
#   7. /opt/wakir/bin/wakir-persona-engine-recovery
#      (Tag-17 Mini-Welle PR #167 — R1..R4 recovery-workflow bridge)
#   8. /opt/wakir/bin/wakir-persona-engine-state-backing
#      (Tag-17 Mini-Welle PR #167 — NATS-KV state-backing bridge)
#   9. /opt/wakir/bin/wakir-persona-engine-subscribe-loop
#      (Tag-22 Mini-Welle PR #181 — NATS-JetStream ack-record bridge;
#      Cosign-Policy 7-binary inventory landed lock-step in Tag-24.)
#  10. /opt/wakir/bin/wakir-persona-engine-svid-workload-identity
#      (Tag-25 Mini-Welle PR #191 wired the Python resolver,
#      Tag-29 Mini-Welle ships the Rust crate skeleton + image-build;
#      SPIFFE Workload-API socket-presence probe bridge; Cosign-Policy
#      8-binary inventory landed lock-step in Tag-29.)
#  11. /opt/wakir/bin/wakir-persona-engine-v907-verify
#      (Tag-19 Mini-Welle PR #171 — V-907 pin-hash bridge)
#
# Cross-Review-Anchor: Zone-C (Container-Image-Pipeline x Tomás-OTS)
# ------------------------------------------------------------------
# The carrier image is the same wakir-persona-engine image that the
# Tag-15-Konsens-Bundle persona-tomas-Quadlet pins; no image-build-
# path change introduced here. The image digest placeholder is
# resolved Operator-Hand via the ``resolve-image-pins-ci.yml``
# workflow once Operator-Hand confirms the upstream Sigstore-keyless
# signature (per docs/operations/cosign-policy-phase-3b.md §3). The
# Quadlet stays byte-parity-aligned with the carrier-image digest
# the Cosign-Policy declares.
#
# Why oneshot, not long-running
# -----------------------------
# The carrier image is a Rust toolchain + the persona-engine Python
# host. Holding it permanently resident solely to expose ``/opt/
# wakir/bin/`` is wasteful — instead this unit runs once at boot
# (via ``Restart=no`` + ``Type=oneshot``), copies the nine binaries
# from the carrier image to the host-side ``wakir-rust-cli-bin``
# named-volume mounted at ``/opt/wakir/bin/``, then exits. Repeated
# starts re-install (idempotent overwrite).
#
# Operator install path (rootful Podman)
# --------------------------------------
#   sudo install -m 644 quadlet/wakir-rust-cli.container \
#       /etc/containers/systemd/wakir-rust-cli.container
#   sudo install -m 644 quadlet/wakir-rust-cli-bin.volume \
#       /etc/containers/systemd/wakir-rust-cli-bin.volume
#   sudo install -d -m 755 /opt/wakir/bin
#   sudo systemctl daemon-reload
#   sudo systemctl start wakir-rust-cli.service
#
# Verification (Operator-Hand per ADR-0051)
# -----------------------------------------
#   systemctl status wakir-rust-cli.service
#   journalctl -u wakir-rust-cli.service --since '5 min ago'
#   ls -l /opt/wakir/bin/wakir-persona-engine-*
#   /opt/wakir/bin/wakir-persona-engine-recovery --version
#
# Tear-down
# ---------
#   sudo systemctl stop wakir-rust-cli.service
#   podman volume rm wakir-rust-cli-bin   # optional, full purge
#
# Image-Pin form (Cosign-Digest-Pin Pfad B): placeholder token
# ``DIGEST_PENDING_KAI_CROSS_REVIEW`` — same convention as the
# Cosign-Policy (policies/cosign-policy-phase-3b.yaml) and the
# persona-tomas Quadlet. The ``resolve-image-pins-ci.yml`` workflow
# propagates the resolved digest into all three files in lock-step
# so the carrier-image digest stays single-sourced.

[Unit]
Description=Wakir Tag-22/24/29/31/45 Phase-3b Rust-CLI host-side binary installer (oneshot, 11 carrier-image binaries)
Documentation=https://github.com/wakir-labs/wakir-runtime/blob/main/docs/operations/quadlets-phase-3b-rust-cli.md
After=network-online.target
Wants=network-online.target
Requires=wakir-rust-cli-bin-volume.service

[Container]
ContainerName=wakir-rust-cli-installer

# Image pin: carrier image digest-pinned via Cosign-Policy Zone-C.
# Placeholder token resolved Operator-Hand via resolve-image-pins-ci.
# Matches policies/cosign-policy-phase-3b.yaml carrier_image entry
# byte-for-byte (registry + repository + tag + digest slot).
Image=ghcr.io/wakir-labs/wakir-persona-engine:0.5.0-pilot@sha256:DIGEST_PENDING_KAI_CROSS_REVIEW

# Entry override: launch a shell that copies the nine canonical
# binaries from the in-image install path into the bind-mounted
# host-side volume. ``install -m 0755`` preserves the executable
# bit on the host copy. The shell exits 0 on success, non-zero on
# any missing binary (the in-image-binary-probe step from
# docs/operations/cosign-policy-phase-3b.md §3 step 3, hardened by
# ``set -e``).
Entrypoint=/bin/sh
Exec=-c "set -e; for b in wakir-persona-engine-recovery wakir-persona-engine-state-backing wakir-persona-engine-fsm wakir-persona-engine-v907-verify wakir-persona-engine-bridge-diff wakir-persona-engine-subscribe-loop wakir-persona-engine-anchor-emitter wakir-persona-engine-svid-workload-identity wakir-persona-engine-bridge-audit-writer wakir-persona-engine-bridge-audit-replay wakir-persona-engine-migrate-version; do test -x \"/opt/wakir/bin/$b\" || { echo \"missing or non-exec in carrier image: $b\" >&2; exit 2; }; install -m 0755 \"/opt/wakir/bin/$b\" \"/host-bin/$b\"; done; echo OK"

# Read-only root filesystem. The installer writes only to the
# bind-mounted host-bin path.
ReadOnly=true

# Run as non-root uid:gid (parity with persona-tomas + SPIRE-Agent).
# The /host-bin volume carries :U to remap ownership at mount-time.
User=1000
Group=1000

# Host-side binary install location, mounted as a Quadlet named-
# volume sidecar. ``:Z`` is the SELinux relabel-private flag
# (FCOS enforcing-mode hosts; ADR-0009 Sprint-9-Tag-8 Bug-20
# substance-fix). ``:U`` remaps named-volume ownership to the
# container's uid:1000 (same fix shape as the SPIRE-Agent + NATS
# named volumes). Both flags are mandatory per the
# test_quadlet_selinux_relabel.py discipline-test.
Volume=wakir-rust-cli-bin.volume:/host-bin:Z,U

# Container-init hardening (parity with sibling Quadlets).
DropCapability=ALL
NoNewPrivileges=true

# Resource envelope. The installer is I/O-bound; a 0.2 CPU /
# 128MB envelope is generous for nine ``install`` invocations.
PodmanArgs=--cpus=0.2 --memory=128m

[Service]
# One-shot install — the unit exits 0 after the nine binaries
# are in place. ``RemainAfterExit=yes`` lets dependent units
# (future host-side recovery-drill scripts) Require= this unit
# without re-launching the container.
Type=oneshot
RemainAfterExit=yes

# Restart policy: oneshot install path; ``Restart=no`` so a
# failure is operator-visible rather than auto-masked. Sibling
# wakir-nats-kv-bucket-init.service uses the same policy.
Restart=no
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target default.target
