#
# Tag-55 Mini-Welle — Welle-5 dedicated single-binary installer Quadlet
# ====================================================================
#
# ADR-0066 Welle-5 Quadlet — installs the dedicated single-binary
# image for ``fsm-welle5`` (the lifecycle FSM operator-CLI; spec
# §3.3 six-state nine-transition envelope). Sibling-shape with
# ``wakir-rust-cli-welle4.container``; see that file for design
# rationale.

# Canonical in-image binary path installed by this Quadlet (anchor
# for Tag-55 readiness-check G5):
#
#   /opt/wakir/bin/wakir-persona-engine-fsm-welle5

[Unit]
Description=Wakir ADR-0066 Welle-5 fsm-welle5 dedicated single-binary installer (oneshot)
Documentation=https://github.com/wakir-labs/wakir-runtime/blob/main/docs/operations/quadlets-phase-3b-rust-cli.md
After=network-online.target
Wants=network-online.target
Requires=wakir-rust-cli-bin-volume.service

[Container]
ContainerName=wakir-rust-cli-welle5-installer

# Image pin: dedicated single-binary image for the Welle-5 cutover
# step. Resolved Operator-Hand via resolve-image-pins-ci.
Image=ghcr.io/wakir-labs/wakir-persona-engine-fsm:0.5.0-pilot@sha256:98d15a21a9f5da2a1c26177e55de964c7d923c28429d941068db9d690d32c93e

# Copy the one canonical binary from the dedicated single-binary
# image into the bind-mounted host-side volume.
Entrypoint=/bin/sh
Exec=-c "set -e; for b in wakir-persona-engine-fsm-welle5; do test -x \"/opt/wakir/bin/$b\" || { echo \"missing or non-exec in welle5 image: $b\" >&2; exit 2; }; install -m 0755 \"/opt/wakir/bin/$b\" \"/host-bin/$b\"; done; echo OK"

ReadOnly=true
User=1000
Group=1000
Volume=wakir-rust-cli-bin.volume:/host-bin:Z,U
DropCapability=ALL
NoNewPrivileges=true
PodmanArgs=--cpus=0.2 --memory=128m

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
