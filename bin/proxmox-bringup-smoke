#!/usr/bin/env bash
# SPDX-License-Identifier: BUSL-1.1
# Copyright (c) 2026 Callandor GmbH and contributors
# License: Business Source License 1.1 — see wirelang/federation/LICENSE-BSL.md
#
# Re-licensed Apache-2.0 -> BSL 1.1 in Sprint-9 Tag-6 per ADR-0059
# (Phase-2-Federation BSL coverage). This script is Federation-
# Substance-adjacent: it self-verifies the live Federation-Server
# bring-up substrate (SPIRE-Server, SPIRE-Agent, NATS-KV marker-
# stack-bucket). Its observation surface mirrors the BSL Quadlet
# templates and the Pilot-Bootstrap one-shot script, both of which
# carry BSL.
#
# Phase-2 Sprint-9 Tag-1 — Operator-Hand Self-Verify nach Proxmox-VM
# Bring-up. Companion zu PROXMOX_BRING_UP_RECIPE.md §6.
#
# Sprint-9 Tag-5 race-tolerance update
# ------------------------------------
# Vier Race-toleranten Checks (jetstream-reachable, spire-server-healthy,
# spire-agent-healthy, marker-stack-bucket-present) verwenden einen
# Retry-Wrapper mit exponentiellem Backoff. Default: 5 Retries + 1
# initial; Sleeps 0.5/1/2/4/5s; Worst-case ~12.5s pro Check.
# Sprint-9-Tag-5-Race-Window-Hypothesen (Mira-Bug-Bilanz 2026-05-13):
#   - JWT-Auth-Timing-Race (Hypothese 1): SPIRE-Agent-SVID-Issuance + NATS-Connect
#   - Trust-Bundle-Rotation-Race (Hypothese 2): Server-Bundle-Lag
#   - SPIFFE-Workload-API-Socket-Permission-Drift (Hypothese 3): SELinux/uid
#   - NATS-KV-Bucket-Init-Race (Hypothese 4): JetStream-Stream-Registration
# Sprint-9 Tag-5 adressiert (1), (2), (4) ueber den Retry-Wrapper plus
# das wirelang-side `connect_retry`-Modul. (3) ist Kai-Sprint-9-Tag-5-Bug-7
# (SPIRE-Agent-Stabilitaet) — der Retry-Wrapper toleriert (3) als generischen
# Connect-Fail aber loest das Permission-Issue nicht.
#
# Was es prueft:
#   1. quadlet-units-active           — alle vier Pilot-Units aktiv
#                                       (wakir-nats, wakir-spire-server-
#                                       federation-wakir, wakir-spire-
#                                       agent-wakir, wakir-nats-kv-
#                                       bucket-init letzteres oneshot:
#                                       "inactive (dead)" akzeptiert).
#   2. nats-jetstream-reachable       — http://127.0.0.1:8222/jsz ok.
#   3. spire-server-healthy           — spire-server healthcheck ok.
#   4. spire-agent-healthy            — spire-agent healthcheck ok.
#   5. spire-workload-api-reachable   — Workload-API-Socket existiert.
#   6. marker-stack-bucket-present    — per-org Marker-Stack-Bucket
#                                       (--org acme) ist in der KV-Liste.
#
# Sandbox-Grenze: dieses Skript SOLL auf der Pilot-VM laufen, nicht
# in der Sandbox. Hermetische Tests fuer die Check-Logik selbst leben
# unter tests/orchestrator/test_proxmox_bringup_smoke.py mit
# Mock-Patterns fuer alle externen Aufrufe.
#
# Exit-Codes:
#   0  alle Checks PASS
#   1  Argument-Fehler / Pre-Flight-Fehler
#   2  mindestens ein Check FAIL
#
# Aufruf:
#   sudo /opt/wakir-runtime/bin/proxmox-bringup-smoke --org acme
#   sudo /opt/wakir-runtime/bin/proxmox-bringup-smoke --org acme --json
#
# Test-Hooks (fuer hermetic-mode):
#   WAKIR_SMOKE_SYSTEMCTL  Pfad zu einem alternativen systemctl-Wrapper
#   WAKIR_SMOKE_PODMAN     Pfad zu einem alternativen podman-Wrapper
#   WAKIR_SMOKE_CURL       Pfad zu einem alternativen curl-Wrapper
#   WAKIR_SMOKE_NATS       Pfad zu einem alternativen nats-CLI-Wrapper
#   WAKIR_SMOKE_RETRY_MAX  Max-Anzahl Retry-Versuche pro Race-toleranter Check
#                          (Default 5; Wert 0 deaktiviert das Retry-Wrapping
#                          und ist die Sprint-9-Tag-1-Baseline-Semantik).
#   WAKIR_SMOKE_RETRY_BASE Backoff-Basisintervall in Sekunden (Default 0.5).
#                          Effektive Sleeps: 0.5s, 1.0s, 2.0s, 3.0s, 5.0s
#                          fuer die Default-Sequenz. Race-Toleranz adressiert
#                          die Sprint-9-Tag-5-Bug-Bilanz (2/6 <-> 4/6
#                          Smoke-Discrepancy via SVID-Cache-Race +
#                          JetStream-Stream-Init-Race).
#   WAKIR_SMOKE_SLEEP      Pfad zu einem alternativen sleep-Wrapper
#                          (hermetic-tests injizieren einen No-Op-Sleep,
#                          damit Race-Reproduktion sub-Sekunden bleibt).
# Default ist jeweils das System-Binary.

set -u

PROG=$(basename "$0")

# ---------------------------------------------------------------------------
# Argumente
# ---------------------------------------------------------------------------

ORG=""
EMIT_JSON=0

usage() {
  cat <<'EOF'
Usage: proxmox-bringup-smoke --org <ORG_ID> [--json]

Phase-2 Sprint-9 Tag-1 Operator-Hand Self-Verify nach Proxmox-Bring-up.

Required:
  --org <ORG_ID>   pilot-org id (e.g. acme) — bucket=wakir-marker-stack-<ORG>

Optional:
  --json           emit a JSON report on stdout in addition to the human log
  -h, --help       show this help and exit

Exit codes:
  0  all checks PASS
  1  argument / pre-flight error
  2  at least one check FAIL
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --org)
      ORG="${2:-}"
      shift 2
      ;;
    --json)
      EMIT_JSON=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "[$PROG] ERROR: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$ORG" ]]; then
  echo "[$PROG] ERROR: --org is required" >&2
  usage >&2
  exit 1
fi

# Validate org_id (mirror of the Wirelang-side _IDENT_RE):
if ! [[ "$ORG" =~ ^[A-Za-z0-9][A-Za-z0-9_.:\-]*$ ]]; then
  echo "[$PROG] ERROR: --org $ORG does not match permitted-character pattern" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Tool-Wrapper (test-hook freundlich)
# ---------------------------------------------------------------------------

SYSTEMCTL="${WAKIR_SMOKE_SYSTEMCTL:-systemctl}"
PODMAN="${WAKIR_SMOKE_PODMAN:-podman}"
CURL="${WAKIR_SMOKE_CURL:-curl}"
NATS="${WAKIR_SMOKE_NATS:-}"  # optional; via podman-run wenn leer
SLEEP="${WAKIR_SMOKE_SLEEP:-sleep}"

# Retry-Konfiguration (Sprint-9 Tag-5 race-tolerance).
# RETRY_MAX = 0 deaktiviert das Retry-Wrapping (Baseline-Semantik fuer
# Tag-1 hermetic tests). RETRY_MAX > 0 macht die als race-tolerant
# markierten Checks N-mal versuchen mit exponentiellem Backoff.
RETRY_MAX="${WAKIR_SMOKE_RETRY_MAX:-5}"
RETRY_BASE="${WAKIR_SMOKE_RETRY_BASE:-0.5}"

# ---------------------------------------------------------------------------
# Check-Framework
# ---------------------------------------------------------------------------

declare -a RESULTS_NAME=()
declare -a RESULTS_STATUS=()
declare -a RESULTS_DETAIL=()
declare -a RESULTS_ATTEMPTS=()

record() {
  RESULTS_NAME+=("$1")
  RESULTS_STATUS+=("$2")
  RESULTS_DETAIL+=("$3")
  RESULTS_ATTEMPTS+=("${4:-1}")
  printf '[bringup-smoke] %-32s %s' "$1" "$2"
  if [[ -n "$3" ]]; then
    printf '  (%s)' "$3"
  fi
  if [[ "${4:-1}" -gt 1 ]]; then
    printf '  [attempts=%s]' "${4}"
  fi
  printf '\n'
}

# ---------------------------------------------------------------------------
# Retry-Wrapper (Sprint-9 Tag-5 race-tolerance)
#
# Driver fuer race-toleranten Check: probe-callable wird bis zu RETRY_MAX-mal
# aufgerufen; bei Rueckgabe 0 (PASS) gibt der Wrapper sofort die Attempt-Zahl
# auf stdout und exit 0. Sleep-Intervalle: RETRY_BASE * 2^(attempt-1), gekappt
# bei 5 Sekunden, sodass der schlimmste Fall RETRY_MAX=5 + RETRY_BASE=0.5 in
# 0.5+1.0+2.0+4.0+5.0 = 12.5s konvergiert. Hermetic-Tests injizieren
# WAKIR_SMOKE_SLEEP=/path/to/noop-sleep, damit das Race-Reproduktions-Setup
# instant durchlaeuft.
#
# Aufruf: with_retry <fn> [args...]
#   Die <fn> MUSS rueckgabewert-protokoll-konform sein: 0 == race-cleared,
#   nicht-0 == race-window-still-open. Die <fn> selber emittiert KEIN
#   record-Output; der race-Treiber-Wrapper macht den finalen record-Aufruf.
#
# Output (auf stdout): "ATTEMPTS=<n>" gefolgt von dem letzten "DETAIL=..."
# Zeilen-Block, sodass der Caller die finale Detail-Nachricht plus die
# Attempt-Zahl auseinander-parsen kann.
# ---------------------------------------------------------------------------

retry_sleep() {
  # Exponentielles Backoff mit Cap: base * 2^(attempt-1), max 5s.
  local attempt="$1"
  local base="$2"
  # Use awk so we can multiply floats without bc dependency.
  local secs
  secs=$(awk -v b="$base" -v a="$attempt" \
    'BEGIN { v = b * (2 ^ (a - 1)); if (v > 5) v = 5; printf "%.3f", v }')
  "$SLEEP" "$secs" >/dev/null 2>&1 || true
}

with_retry() {
  # Driver fuer race-toleranten Check.
  # Argumente: <fn> [args...]
  # Globalvariablen die <fn> setzt: RETRY_DETAIL (Detail-Nachricht).
  # Rueckgabe: 0 wenn fn irgendwann ok geworden ist (innerhalb RETRY_MAX+1
  # Versuchen), sonst der letzte non-zero Rueckgabewert von fn.
  # Setzt globals: RETRY_LAST_ATTEMPTS (Anzahl Versuche), RETRY_LAST_DETAIL.

  local fn="$1"; shift
  local attempt rc=0 final_attempt=0
  RETRY_LAST_DETAIL=""
  RETRY_LAST_ATTEMPTS=0
  for (( attempt=1; attempt <= RETRY_MAX + 1; attempt++ )); do
    RETRY_DETAIL=""
    # Capture the probe's actual exit code by running it as the
    # immediate command (not inside an "if"-condition) — that way
    # $? reflects the probe's return value, not the if-statement's.
    "$fn" "$@"
    rc=$?
    if [[ $rc -eq 0 ]]; then
      RETRY_LAST_ATTEMPTS=$attempt
      RETRY_LAST_DETAIL="$RETRY_DETAIL"
      return 0
    fi
    final_attempt=$attempt
    # Sleep before the next try, but not after the final attempt.
    if (( attempt <= RETRY_MAX )); then
      retry_sleep "$attempt" "$RETRY_BASE"
    fi
  done
  RETRY_LAST_ATTEMPTS=$final_attempt
  # Letzter RETRY_DETAIL gewinnt; falls fn ihn auf der letzten Iteration
  # geleert hat, faellt der record-Aufruf auf "no detail" zurueck.
  RETRY_LAST_DETAIL="$RETRY_DETAIL"
  return $rc
}

# ---------------------------------------------------------------------------
# Check 1: quadlet-units-active
# ---------------------------------------------------------------------------

check_quadlet_units_active() {
  local units=(
    wakir-nats.service
    wakir-spire-server-federation-wakir.service
    wakir-spire-agent-wakir.service
  )
  local missing=()
  local unit
  for unit in "${units[@]}"; do
    local state
    state=$("$SYSTEMCTL" is-active "$unit" 2>/dev/null || true)
    if [[ "$state" != "active" ]]; then
      missing+=("$unit:$state")
    fi
  done
  # One-shot unit acceptable in inactive state after successful run.
  local oneshot="wakir-nats-kv-bucket-init.service"
  local oneshot_state
  oneshot_state=$("$SYSTEMCTL" is-failed "$oneshot" 2>/dev/null || true)
  if [[ "$oneshot_state" == "failed" ]]; then
    missing+=("$oneshot:failed")
  fi
  if [[ ${#missing[@]} -eq 0 ]]; then
    record "quadlet-units-active" "PASS" "all 3 long-running + 1 oneshot units ok"
  else
    record "quadlet-units-active" "FAIL" "${missing[*]}"
  fi
}

# ---------------------------------------------------------------------------
# Check 2: nats-jetstream-reachable (race-tolerant per Sprint-9 Tag-5)
#
# Race-Window: NATS-Server kann TCP-akzeptierend sein bevor JetStream
# fertig initialisiert ist; /jsz antwortet dann ohne "streams"-Feld.
# Retry-Wrapped damit der race-window-clear-time toleriert wird.
# ---------------------------------------------------------------------------

_probe_nats_jetstream() {
  # Returns 0 if /jsz responds with streams field; non-zero otherwise.
  # Sets RETRY_DETAIL to a reason-coded message.
  local body
  body=$("$CURL" -s --max-time 5 http://127.0.0.1:8222/jsz 2>/dev/null || true)
  if [[ -z "$body" ]]; then
    RETRY_DETAIL="no response from /jsz (race: nats-server-not-listening)"
    return 1
  fi
  if ! echo "$body" | grep -q '"streams"'; then
    RETRY_DETAIL="no streams field (race: jetstream-init-pending)"
    return 1
  fi
  RETRY_DETAIL="/jsz responded with streams field"
  return 0
}

check_nats_jetstream_reachable() {
  if with_retry _probe_nats_jetstream; then
    record "nats-jetstream-reachable" "PASS" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  else
    record "nats-jetstream-reachable" "FAIL" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  fi
}

# ---------------------------------------------------------------------------
# Check 3: spire-server-healthy (race-tolerant per Sprint-9 Tag-5)
#
# Race-Window: SPIRE-Server kann waehrend Agent-Crash-Loop kurzzeitig
# unhealthy werden bevor er sich stabilisiert. Sprint-9 Tag-5
# Bug-Bilanz-Discrepancy 2/6 <-> 4/6 erklaert sich primaer ueber Server-
# und Bucket-Race-Windows. Retry adressiert den Server-Window.
# ---------------------------------------------------------------------------

_probe_spire_server_healthy() {
  local out
  if out=$("$PODMAN" exec wakir-spire-server-federation-wakir \
        /opt/spire/bin/spire-server healthcheck 2>&1); then
    RETRY_DETAIL="$(echo "$out" | head -1)"
    return 0
  fi
  RETRY_DETAIL="$(echo "$out" | head -1) (race: server-restart-loop-window)"
  return 1
}

check_spire_server_healthy() {
  if with_retry _probe_spire_server_healthy; then
    record "spire-server-healthy" "PASS" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  else
    record "spire-server-healthy" "FAIL" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  fi
}

# ---------------------------------------------------------------------------
# Check 4: spire-agent-healthy (race-tolerant per Sprint-9 Tag-5)
#
# Race-Window: Agent crash-loop kann zwischen den Versuchen stabilisieren;
# der Retry-Wrapper toleriert das. Kai-Sprint-9-Tag-5 (Bug 7) owns die
# primaere Agent-Stabilitaets-Resolution; das Retry-Wrapping ist additive
# defence-in-depth.
# ---------------------------------------------------------------------------

_probe_spire_agent_healthy() {
  # Sprint-9 Tag-6 Bug 14 fix:
  # `spire-agent healthcheck` defaults to socket path
  # `/tmp/spire-agent/public/api.sock` (SPIRE upstream default), but
  # our Workload-API socket is bound to
  # `/run/spire/agent-sockets/api.sock` via the agent-sockets volume.
  # Without `-socketPath` the healthcheck returns "Agent is unhealthy:
  # unable to determine health" even when the Agent is running fine.
  # Mirrors the working `check_spire_workload_api_reachable` invocation.
  local out
  if out=$("$PODMAN" exec wakir-spire-agent-wakir \
        /opt/spire/bin/spire-agent healthcheck \
          -socketPath /run/spire/agent-sockets/api.sock 2>&1); then
    RETRY_DETAIL="$(echo "$out" | head -1)"
    return 0
  fi
  RETRY_DETAIL="$(echo "$out" | head -1) (race: agent-svid-issuance-window)"
  return 1
}

check_spire_agent_healthy() {
  if with_retry _probe_spire_agent_healthy; then
    record "spire-agent-healthy" "PASS" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  else
    record "spire-agent-healthy" "FAIL" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  fi
}

# ---------------------------------------------------------------------------
# Check 5: spire-workload-api-reachable
# ---------------------------------------------------------------------------

check_spire_workload_api_reachable() {
  # The agent-sockets named volume mounts the Workload-API socket
  # inside the container at /run/spire/agent-sockets/api.sock. We
  # exec into the agent container and ask the SPIRE binary to dial it.
  local out
  if out=$("$PODMAN" exec wakir-spire-agent-wakir \
        /opt/spire/bin/spire-agent api fetch x509 \
          -socketPath /run/spire/agent-sockets/api.sock 2>&1); then
    record "spire-workload-api-reachable" "PASS" \
      "fetch x509 succeeded"
  else
    # "no identity issued" is acceptable for the bring-up smoke if
    # no test workload entry has been registered yet (recipe §4.5).
    if echo "$out" | grep -q "no identity issued"; then
      record "spire-workload-api-reachable" "PASS" \
        "socket reachable; no entry registered (acceptable pre-§4.5)"
    else
      record "spire-workload-api-reachable" "FAIL" \
        "$(echo "$out" | head -1)"
    fi
  fi
}

# ---------------------------------------------------------------------------
# Check 6: marker-stack-bucket-present (race-tolerant per Sprint-9 Tag-5)
#
# Race-Window: nach Bucket-Init-Oneshot ist die JetStream-Stream-Registration
# der KV-Buckets asynchron; "nats kv ls" listet den Bucket erst nach dem
# Stream-Registration-Callback durch ist. Bug-Bilanz-Discrepancy 2/6 <-> 4/6
# erklaert sich primaer ueber diesen Race + Check-3 (server-restart-loop).
# Retry-Wrapped damit der race-window-clear-time toleriert wird.
# ---------------------------------------------------------------------------

_probe_marker_stack_bucket_via_nats_cli() {
  # Probes via direct nats-CLI on the host. Uses globals: NATS (cmd),
  # ORG. Sets RETRY_DETAIL.
  #
  # Sprint-9 Tag-6 Bug 13 fix:
  # nats-CLI 0.1.5 + nats-box-Image latest emit a box-bordered table:
  #   ` | wakir-marker-stack-acme | description | created | ...`
  # The previous `grep -qx "$bucket"` required an exact-line match,
  # which the box-border-prefixed line never satisfied → FAIL trotz
  # Bucket-Existenz. We use a regex with character-class boundaries
  # so the bucket name only matches when it stands as its own token
  # (preventing spurious matches against e.g.
  # wakir-marker-stack-acme-tenant).
  local bucket="wakir-marker-stack-${ORG}"
  local out
  if out=$("$NATS" kv ls --server nats://127.0.0.1:4222 2>&1); then
    if echo "$out" | grep -qE "(^|[^A-Za-z0-9_.:-])${bucket}([^A-Za-z0-9_.:-]|$)"; then
      RETRY_DETAIL="$bucket"
      return 0
    fi
    RETRY_DETAIL="$bucket not in nats kv ls output (race: stream-registration-pending)"
    return 1
  fi
  RETRY_DETAIL="nats-cli failure: $(echo "$out" | head -1)"
  return 1
}

_probe_marker_stack_bucket_via_podman_nats_box() {
  # Probes via podman-run on the orchestrator network. Sets RETRY_DETAIL.
  #
  # Sprint-9 Tag-6 Bug 13 fix: same parser hardening as the nats-CLI
  # variant above — nats-box latest emits a box-bordered table, so we
  # use the same boundary-anchored regex to tolerate any leading or
  # trailing decoration while still rejecting strict superstrings.
  local bucket="wakir-marker-stack-${ORG}"
  local out
  if out=$("$PODMAN" run --rm --network wakir-orchestrator \
        docker.io/natsio/nats-box:latest \
        nats kv ls --server nats://wakir-nats:4222 2>&1); then
    if echo "$out" | grep -qE "(^|[^A-Za-z0-9_.:-])${bucket}([^A-Za-z0-9_.:-]|$)"; then
      RETRY_DETAIL="$bucket"
      return 0
    fi
    RETRY_DETAIL="$bucket not in nats kv ls output (race: stream-registration-pending)"
    return 1
  fi
  RETRY_DETAIL="podman-run failure: $(echo "$out" | head -1)"
  return 1
}

check_marker_stack_bucket_present() {
  local probe
  if [[ -n "$NATS" ]]; then
    probe=_probe_marker_stack_bucket_via_nats_cli
  else
    probe=_probe_marker_stack_bucket_via_podman_nats_box
  fi

  if with_retry "$probe"; then
    record "marker-stack-bucket-present" "PASS" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  else
    record "marker-stack-bucket-present" "FAIL" \
      "$RETRY_LAST_DETAIL" "$RETRY_LAST_ATTEMPTS"
  fi
}

# ---------------------------------------------------------------------------
# Run the suite
# ---------------------------------------------------------------------------

check_quadlet_units_active
check_nats_jetstream_reachable
check_spire_server_healthy
check_spire_agent_healthy
check_spire_workload_api_reachable
check_marker_stack_bucket_present

# ---------------------------------------------------------------------------
# Summary + Exit
# ---------------------------------------------------------------------------

PASS=0
FAIL=0
for s in "${RESULTS_STATUS[@]}"; do
  case "$s" in
    PASS) PASS=$((PASS + 1)) ;;
    FAIL) FAIL=$((FAIL + 1)) ;;
  esac
done
TOTAL=$((PASS + FAIL))

printf '[bringup-smoke] SUMMARY: %d/%d checks PASS\n' "$PASS" "$TOTAL"

if [[ "$EMIT_JSON" -eq 1 ]]; then
  # Compose a JSON report (no jq dependency; deterministic shape).
  printf '{"summary":{"pass":%d,"fail":%d,"total":%d},"results":[' \
    "$PASS" "$FAIL" "$TOTAL"
  for i in "${!RESULTS_NAME[@]}"; do
    if [[ "$i" -gt 0 ]]; then printf ','; fi
    # JSON-escape the detail string minimally (no embedded quote).
    safe_detail=${RESULTS_DETAIL[$i]//\"/\\\"}
    printf '{"name":"%s","status":"%s","detail":"%s"}' \
      "${RESULTS_NAME[$i]}" \
      "${RESULTS_STATUS[$i]}" \
      "$safe_detail"
  done
  printf ']}\n'
fi

if [[ "$FAIL" -gt 0 ]]; then
  exit 2
fi
exit 0
