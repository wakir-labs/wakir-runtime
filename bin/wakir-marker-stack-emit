# Sprint-Pengine-7 Tag-5 OI-PILOT-3 — Operator-facing marker-stack
# emitter CLI entrypoint. Thin shim over
# ``wirelang.cli.marker_stack_emit``.
#
# The hyphen in this filename makes a direct ``import`` syntactically
# impossible; this file does the path setup and delegates to the
# Wirelang-side module.
#
# See ``wirelang/cli/marker_stack_emit.py`` module docstring for the
# full contract.

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_REPO_ROOT = _HERE.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from wirelang.cli.marker_stack_emit import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
