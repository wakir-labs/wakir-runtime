# Sprint-10 Tag-6 substrate-closer — Operator-facing Bridge-Forward-Pipe
# publisher CLI entrypoint. Thin shim over
# ``wirelang.cli.bridge_forward``.
#
# The hyphen in this filename makes a direct ``import`` syntactically
# impossible; this file does the path setup and delegates to the
# Wirelang-side module.
#
# See ``wirelang/cli/bridge_forward.py`` module docstring and
# ``wirelang/specs/bridge-forward-pipe-v1.md`` for the full contract.

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_REPO_ROOT = _HERE.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from wirelang.cli.bridge_forward import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
