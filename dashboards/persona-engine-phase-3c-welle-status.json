      "description": "Welle-5 lifecycle. Doppel mit Welle-4.",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_phase_3c_welle_state{welle=\"5\"} == 1",
