    },
    {
      "id": 200,
      "type": "row",
      "title": "Per-Welle BackendDecision Split (python vs rust)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "BackendDecision counts per welle (python | rust | other)",
      "description": "Per-welle counter view of how many BackendDecisions landed on python vs. rust vs. other. A sustained python skew on a welle in in_cutover OR post_cutover state means the Rust binary is missing or non-executable on the host - check the fallback_total panel.",
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 29},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_phase_3c_welle_decisions_total{welle=~\"$welle\"}",
          "refId": "A",
          "legendFormat": "welle {{welle}} {{domain}} {{backend}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "values": ["value"]},
        "tooltip": {"mode": "multi"},
        "orientation": "vertical",
        "stacking": "normal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "decimals": 0
        }
      }
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Fallback-records per welle",
      "description": "Count of BackendDecisions where fallback_reason was non-empty. A non-zero bar on a welle in in_cutover or post_cutover is the operator's immediate red flag.",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 29},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_phase_3c_welle_fallback_total{welle=~\"$welle\"}",
          "refId": "A",
          "legendFormat": "welle {{welle}} {{domain}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "values": ["value"]},
        "tooltip": {"mode": "multi"},
        "orientation": "vertical",
        "stacking": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Per-Welle Latency Comparison (python p50/p95/p99 vs rust)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Latency p50 us per welle (python vs rust)",
      "description": "Median resolution-latency from the BackendDecision JSONL. The cutover-acceptance criterion is that the rust median is at-most 1.5x the python median (per ADR-0065 v907_verify acceptance band). Values above that line warrant a rollback discussion.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_phase_3c_welle_latency_us{welle=~\"$welle\",quantile=\"0.5\"}",
          "refId": "A",
          "legendFormat": "welle {{welle}} {{domain}} {{backend}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "us",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Latency p95 us per welle (python vs rust)",
      "description": "p95 resolution-latency per welle. p95 catches sporadic outliers the median hides.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_phase_3c_welle_latency_us{welle=~\"$welle\",quantile=\"0.95\"}",
          "refId": "A",
          "legendFormat": "welle {{welle}} {{domain}} {{backend}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "us",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Latency p99 us per welle (python vs rust)",
      "description": "p99 resolution-latency per welle. p99 is the tail-risk signal; ADR-0065 Welle-Acceptance permits p99 <= 3x python baseline.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 48},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_phase_3c_welle_latency_us{welle=~\"$welle\",quantile=\"0.99\"}",
          "refId": "A",
          "legendFormat": "welle {{welle}} {{domain}} {{backend}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "us",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Welle-3 High-Frequency Telemetry (ADR-0066 Mitigation-2)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 57},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Welle-3 Bridge-Audit-Writer Consistency Score (10s tick)",
      "description": "Welle-3 (bridge_audit_writer) self-consistency score = rust_count / total * 100, sampled at the configured high-frequency tick interval (default 10s). KW-25 solo cutover; the self-score is the rust-rate of bridge_audit_writer reading its own BackendDecisions. Compare against the independent Phase-2 cross-modul stress-test oracle in the panel to the right. Source: scripts/welle-3-telemetry-emitter.py.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 58},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_welle_3_consistency_score",
          "refId": "A",
          "legendFormat": "welle-3 self-score"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 90},
              {"color": "green", "value": 99}
            ]
          }
        }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Phase-2 Cross-Modul Stress-Test Oracle (Trendline)",
      "description": "Independent oracle: Phase-2 cross-modul stress-test result, sampled outside the bridge_audit_writer code path. Henrik (Internal Audit) flagged the Welle-3 self-cutover-oracle risk in the ADR-0066 review; the stress test is the independent measurement that breaks the circular oracle. Trendline shows the stress-test cross-modul-rust-rate; status label switches GREEN/RED/YELLOW.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 58},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_welle_3_stress_oracle_score",
          "refId": "A",
          "legendFormat": "stress oracle ({{status}})"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 90},
              {"color": "green", "value": 99}
            ]
          }
        }
      }
    },
    {
      "id": 43,
      "type": "stat",
      "title": "Welle-3 Self-vs-Oracle Divergence (percentage points)",
      "description": "Absolute delta between Welle-3 self-score and Phase-2 stress oracle score. ADR-0066 Mitigation-2 rollback trigger: divergence > 0.5pp (default threshold). Red threshold is intentionally tight so an operator who misses the alert text sees a red tile.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 66},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_welle_3_divergence_pct",
          "refId": "A",
          "legendFormat": "divergence pp"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.3},
              {"color": "red", "value": 0.5}
            ]
          }
        }
      }
    },
    {
      "id": 44,
      "type": "stat",
      "title": "Welle-3 Red-Flag (>0.5% divergence -> rollback)",
      "description": "Binary red-flag tile. 1 = ADR-0066 Mitigation-2 rollback trigger fired (divergence > threshold OR stress oracle reports fail). 0 = green. The reason label carries the diagnostic for the on-call operator (e.g. 'divergence-3.0000pct-exceeds-threshold-0.5000pct' or 'stress-oracle-status-fail').",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 66},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_welle_3_divergence_red_flag",
          "refId": "A",
          "legendFormat": "red-flag ({{reason}})"
