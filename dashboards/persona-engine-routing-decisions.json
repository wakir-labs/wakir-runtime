{
  "__comment": "Grafana dashboard JSON for the wakir-persona-engine Tag-16 Routing-Decision-Observability surface (Noa Bergstroem / SRE). Consumes Prometheus gauges produced by scripts/routing-decision-observability.py. Schema version targets Grafana 10.x (schemaVersion >= 38). Every panel answers a concrete operator question: which model is the router choosing, how fast does it decide, which mode-mix is in production, and is the classifier path earning its keep (vs silently falling back). ADR-0064 Phase-2b (PR #159) + Phase-2c (Selin Tag-16).",
  "title": "Wakir Persona-Engine - Routing Decisions",
  "uid": "wakir-persona-engine-routing-decisions",
  "tags": ["wakir", "persona-engine", "sre", "routing", "adr-0064", "phase-2b", "phase-2c"],
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "mode",
        "label": "Routing Mode",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prom"},
        "query": "label_values(persona_engine_routing_decisions_per_mode, mode)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prom"},
        "query": "label_values(persona_engine_routing_decisions_per_model, model)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Decision Mix",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "piechart",
      "title": "Decision Count per Model (current window)",
      "description": "Pie chart of routing-decision counts grouped by the chosen Anthropic model in the current sliding window. Answers 'which tier is the router actually picking right now'. A sudden swing toward opus is a cost-signal worth investigating; a swing toward haiku without an upstream prompt-payload shift hints at heuristic-drift.",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_decisions_per_model{model=~\"$model\"}",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "tooltip": {"mode": "single"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Classifier Hit Rate (current window)",
      "description": "Of all decisions taken in a classifier mode (llm_classifier or llm_classifier_fallback_heuristic), the share that resolved WITHOUT falling back to the heuristic router. 1.0 = the classifier path is earning its keep; <0.95 sustained = early warning that the classifier backend is degrading and traffic is silently landing on the heuristic-fallback path. This is the routing-side cache-hit-rate (the Anthropic prompt-cache-hit-rate is on the Cost & Cache dashboard).",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_classifier_hit_rate",
          "legendFormat": "classifier hit rate",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.8},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Decision Latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 11},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Decision Latency p50/p95/p99 per Mode",
      "description": "Nearest-rank percentile of decision-latency (microseconds) per routing mode in the current sliding window, scraped every minute. The decision step is the substrate hot-path: heuristic-router is target <100us p99, llm_classifier mode is target <50ms p99 (network-bound to Anthropic Haiku-classifier backend). Sustained p99 outside those envelopes is an Error-Budget-burn signal per ADR-0064.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_decision_latency_us{mode=~\"$mode\",quantile=\"0.5\"}",
          "legendFormat": "p50 {{mode}}",
          "refId": "A"
        },
        {
          "expr": "persona_engine_routing_decision_latency_us{mode=~\"$mode\",quantile=\"0.95\"}",
          "legendFormat": "p95 {{mode}}",
          "refId": "B"
        },
        {
          "expr": "persona_engine_routing_decision_latency_us{mode=~\"$mode\",quantile=\"0.99\"}",
          "legendFormat": "p99 {{mode}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "auto"
          },
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "values": ["last", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Mode Distribution",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Per-Mode Distribution Over Time (stacked)",
      "description": "Stacked timeseries of decision counts per routing mode across the dashboard time range. The stack shows the mix evolution: a healthy phase-2c rollout sees llm_classifier and llm_classifier_fallback_heuristic dominate, with static/heuristic taking the long tail (operators that opted out, or fallbacks that mode-coerced down to heuristic). A sudden inversion (static spiking) usually means an env-var rollback or an operator pin to a frozen tier.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_decisions_per_mode{mode=~\"$mode\"}",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 70,
            "stacking": {"mode": "normal", "group": "A"},
            "spanNulls": false,
            "showPoints": "never"
          },
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "values": ["last", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Supplementary Operational Stats",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33},
      "collapsed": true,
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Sample Size (current window)",
      "description": "Number of routing decisions aggregated in the current sliding window. A reading < window_size means the JSONL has not yet saturated; readings AT window_size mean the gauge is steady-state.",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_decisions_sample_size",
          "legendFormat": "sample size",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "orange", "value": null},
              {"color": "green", "value": 50}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Window Size (configured)",
      "description": "WAKIR_ROUTING_OBS_WINDOW value the aggregator is currently honouring. Default is 1000.",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_decisions_window_size",
          "legendFormat": "window",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Classifier Attempts (current window)",
      "description": "Decisions taken in a classifier mode (llm_classifier or llm_classifier_fallback_heuristic). Denominator of the hit-rate gauge.",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_classifier_attempts_total",
          "legendFormat": "attempts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Classifier Fallbacks (current window)",
      "description": "Classifier-mode decisions that fell back to the heuristic router. Sustained non-zero values mean the classifier backend is unstable.",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_classifier_fallbacks_total",
          "legendFormat": "fallbacks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Avg Decision Latency (us, current window)",
      "description": "Arithmetic mean decision latency across all modes in the current window. Use the per-mode percentile panel for actionable diagnosis; this is a single-glance overview.",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_decision_latency_us_avg",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "decimals": 1
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Last Aggregator Scrape (unix seconds)",
      "description": "POSIX-epoch timestamp at which the routing-decision aggregator last wrote the textfile. A value that stops advancing means the systemd-timer wrapper has stalled and the dashboard is showing stale data.",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 40},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [
        {
          "expr": "persona_engine_routing_scrape_timestamp_seconds",
          "legendFormat": "last scrape",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "decimals": 0
        }
      }
    }
  ]
}
