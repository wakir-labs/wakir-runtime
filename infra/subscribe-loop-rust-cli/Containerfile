# wakir-persona-engine-subscribe-loop — Rust-CLI runtime image for
# the NATS-JetStream subscribe-loop operator-CLI (Tag-33 Mini-Welle,
# ADR-0066 Welle-6 `subscribe_loop` pre-cutover image, parallel to
# Welle-1 V907-verify, Welle-2 SVID-workload-identity, Welle-3
# bridge-audit-writer, Welle-4 state-backing and Welle-5 lifecycle-
# state-machine image-builds).
#
# Substrate scope
# ---------------
#
# ADR-0066 (approved 2026-05-17) accelerates Phase-3c to 4 weeks
# (Option A+). **Welle-6 is `subscribe_loop`**: the fifth-lowest-
# blast-radius write-side surface scheduled to flip from Python-
# backend default to Rust-backend default. This image is the
# substrate the cutover step will pin against in the Quadlet unit and
# in the `persona-engine` image's `WAKIR_SUBSCRIBE_LOOP_BACKEND=rust`
# operator-flag pathway.
#
# The binary itself (`wakir-persona-engine-subscribe-loop`) surfaces
# the canonical NATS-JetStream subscribe-loop schema constants
# (inbound `wakir.agent.task-assigned/1`, outbound
# `wakir.agent.task-output/1`, ack-record
# `wakir.persona-engine.subscribe-ack/1`), the NATS-subject
# template (`wakir.{env}.agent.agent.task.assigned.{persona_slug}`)
# and the five valid outcome strings. Byte-identical against the
# Python pendant `wirelang.persona_engine.subscribe_loop` — see
# `wirelang-rust/crates/persona-engine-subscribe-loop/src/main.rs`
# for the subcommand surface (`info | build-subject ENV
# PERSONA_SLUG | --version | --help`).
#
# Multi-stage build
# -----------------
#
# Stage 1 (builder, `rust:1.85-slim-bookworm`) compiles the
# `wakir-persona-engine-subscribe-loop` binary in `--release` mode.
# The release profile is workspace-configured for `lto = "thin"`,
# `codegen-units = 1`, `strip = "symbols"`.
#
# Stage 2 (runtime, `gcr.io/distroless/cc-debian12:nonroot`) carries
# only the binary plus a CA bundle (inherited from distroless-cc).
# No shell, no package manager, no Python — the attack surface is
# the Rust binary plus distroless glibc only.
#
# Why distroless-cc and not scratch
# ---------------------------------
#
# Parity with the V907-verify, SVID-workload-identity, bridge-audit-
# writer, state-backing and lifecycle-state-machine image-builds.
#
# OCI provenance + Cosign signing
# -------------------------------
#
# Build path: ``.github/workflows/build-rust-cli-subscribe-loop.yml``
# (Operator-Hand ``workflow_dispatch`` only).
#
# Cross-references
# ----------------
#
# - ADR-0066 §Phase-3c Welle-6 `subscribe_loop` (approved
#   2026-05-17).
# - ADR-0065 §Welle-6 listing.
# - ADR-0060 — Cosign-Policy on Pilot-Container-Images.
# - PR #132 (`persona-engine-subscribe-loop`) — async-nats version
#   precedent.

# ----------------------------------------------------------------------
# Stage 1 — Rust release builder
# ----------------------------------------------------------------------

FROM docker.io/library/rust:1.85-slim-bookworm@sha256:DIGEST_PENDING_KAI_REVIEW AS builder

WORKDIR /build

COPY wirelang-rust /build/wirelang-rust

WORKDIR /build/wirelang-rust

RUN cargo build --release \
        -p persona-engine-subscribe-loop \
        --bin wakir-persona-engine-subscribe-loop

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends binutils \
    && strip --strip-unneeded \
        /build/wirelang-rust/target/release/wakir-persona-engine-subscribe-loop \
    && apt-get purge -y binutils \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# Stage 2 — distroless runtime
# ----------------------------------------------------------------------

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:DIGEST_PENDING_KAI_REVIEW

LABEL org.opencontainers.image.title="wakir-persona-engine-subscribe-loop"
LABEL org.opencontainers.image.description="Rust-CLI for the persona-engine NATS-JetStream subscribe-loop operator surface (ack-record schema, subject template, valid outcomes). ADR-0066 Welle-6 pre-cutover image (Tag-33 Mini-Welle, 2026-05-18)."
LABEL org.opencontainers.image.version="0.1.0-pilot"
LABEL org.opencontainers.image.licenses="BUSL-1.1"
LABEL org.opencontainers.image.source="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.url="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.documentation="https://github.com/wakir-labs/wakir-runtime/blob/main/docs/operations/subscribe-loop-image-build.md"

COPY --from=builder \
    /build/wirelang-rust/target/release/wakir-persona-engine-subscribe-loop \
    /usr/local/bin/wakir-persona-engine-subscribe-loop

USER nonroot:nonroot

# The CLI exits with documented codes (0=info / build-subject / help
# / version, 1=internal error, 64=usage-error).
ENTRYPOINT ["/usr/local/bin/wakir-persona-engine-subscribe-loop"]
