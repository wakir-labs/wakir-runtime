# wakir-persona-engine-recovery-workflow — Rust-CLI runtime image
# for the R1..R4 Recovery-Workflow read-only utility path (Tag-32
# Mini-Welle, ADR-0066 Welle-7 `recovery_workflow` pre-cutover image,
# parallel to Welle-6 subscribe_loop in KW 27).
#
# Substrate scope
# ---------------
#
# ADR-0066 (approved 2026-05-17) accelerates Phase-3c to 4 weeks
# (Option A+). **Welle-7 is `recovery_workflow`** (KW 27, parallel
# with Welle-6 subscribe_loop): the R1..R4 Recovery-Workflow that
# the persona-engine crash-detection + state-corruption + despawn-
# mid-operation paths drive. This image is the substrate the cutover
# step will pin against in the Quadlet unit and in the persona-
# engine image's `WAKIR_RECOVERY_BACKEND=rust` operator-flag pathway.
#
# The binary itself (`wakir-persona-engine-recovery-workflow`) is
# the Rust operator-CLI pendant of
# `wirelang.persona_engine.recovery_workflow` — see
# `wirelang-rust/crates/persona-engine-recovery/src/main.rs` for the
# subcommand surface (`info | phases | soft-cap <phase> |
# outcome-hash <jcs-file> | --version | --help`). Read-only: the
# binary does NOT orchestrate any actual recovery (the live
# orchestration stays Python-side; this Rust skeleton ships only
# the canonical-constant emission + outcome-hash surface for the
# cross-substrate-parity smoke).
#
# Multi-stage build
# -----------------
#
# Stage 1 (builder, `rust:1.85-slim-bookworm`) compiles the
# `wakir-persona-engine-recovery-workflow` binary in `--release`
# mode. We pin the base image to the workspace's
# `rust-version = "1.85"` (see `wirelang-rust/Cargo.toml`). The
# release profile is workspace-configured for `lto = "thin"`,
# `codegen-units = 1`, `strip = "symbols"`.
#
# Stage 2 (runtime, `gcr.io/distroless/cc-debian12:nonroot`) carries
# only the binary plus a CA bundle (inherited from distroless-cc).
# No shell, no package manager, no Python — the attack surface is
# the Rust binary plus distroless glibc only.
#
# Why distroless-cc and not scratch
# ---------------------------------
#
# Parity with the V907-verify (PR #194) + SVID-workload-identity
# (PR #201) + state-backing + lifecycle-state-machine + subscribe-
# loop (Tag-32 siblings) images.
#
# OCI provenance + Cosign signing
# -------------------------------
#
# Build path: ``.github/workflows/build-rust-cli-recovery-workflow.yml``
# (Operator-Hand ``workflow_dispatch`` only; the
# ``inputs.push='true'`` opt-in pushes to
# ``ghcr.io/wakir-labs/wakir-persona-engine-recovery-workflow:<tag>``
# and Sigstore-keyless-signs the resulting digest. Parity with
# ``build-rust-cli-v907-verify.yml`` from Tag-26 PR #194).
#
# Pin path: the digest emitted by the workflow is resolved into the
# Quadlet unit at cutover time (Welle-7 step on the ADR-0066 Wochen-
# Plan, KW 27). The resolver pattern is the same
# `scripts/image-pin-idempotent-resolver.sh` PINS-array row that the
# persona-engine + V907-verify + SVID-workload-identity images use.
#
# Cross-references
# ----------------
#
# - ADR-0066 §Phase-3c Welle-7 `recovery_workflow` (approved
#   2026-05-17).
# - persona-engine-format-spec §3.7.4 — R1..R4 phase contract.
# - ADR-0060 — Cosign-Policy on Pilot-Container-Images.
# - ADR-0035 §C-Drift-Closure — the ADR this cutover closes for the
#   recovery_workflow module.

# ----------------------------------------------------------------------
# Stage 1 — Rust release builder
# ----------------------------------------------------------------------

FROM docker.io/library/rust:1.85-slim-bookworm@sha256:DIGEST_PENDING_KAI_REVIEW AS builder

WORKDIR /build

COPY wirelang-rust /build/wirelang-rust

WORKDIR /build/wirelang-rust

# Build only the recovery-workflow binary in release mode. The
# workspace profile sets lto+strip; the resulting artefact ends up
# at `target/release/wakir-persona-engine-recovery-workflow`.
RUN cargo build --release \
        -p persona-engine-recovery \
        --bin wakir-persona-engine-recovery-workflow

# Belt-and-suspenders strip.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends binutils \
    && strip --strip-unneeded \
        /build/wirelang-rust/target/release/wakir-persona-engine-recovery-workflow \
    && apt-get purge -y binutils \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------------------------------------
# Stage 2 — distroless runtime
# ----------------------------------------------------------------------

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:DIGEST_PENDING_KAI_REVIEW

LABEL org.opencontainers.image.title="wakir-persona-engine-recovery-workflow"
LABEL org.opencontainers.image.description="Rust-CLI for the persona-engine R1..R4 Recovery-Workflow utility surface (phases, soft-cap, outcome-hash). ADR-0066 Welle-7 pre-cutover image (Tag-32 Mini-Welle, 2026-05-17)."
LABEL org.opencontainers.image.version="0.1.0-pilot"
LABEL org.opencontainers.image.licenses="BUSL-1.1"
LABEL org.opencontainers.image.source="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.url="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.documentation="https://github.com/wakir-labs/wakir-runtime/blob/main/docs/operations/recovery-workflow-image-build.md"

COPY --from=builder \
    /build/wirelang-rust/target/release/wakir-persona-engine-recovery-workflow \
    /usr/local/bin/wakir-persona-engine-recovery-workflow

USER nonroot:nonroot

# The CLI exits with documented codes (0=success, 1=runtime error,
# 3=input file not found, 64=usage error or unknown phase). See
# docs/operations/recovery-workflow-image-build.md.
ENTRYPOINT ["/usr/local/bin/wakir-persona-engine-recovery-workflow"]
