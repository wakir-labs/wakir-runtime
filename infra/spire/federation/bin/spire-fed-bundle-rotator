"""Shim: invoke spire_fed_bundle_rotator.main() with sys.argv[1:].

Kept as a thin shim so the module is import-safe for tests and the
CLI entrypoint is a single line of glue.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Make the sibling module importable without requiring a package layout.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from spire_fed_bundle_rotator import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
