"""Shim: invoke spire_fed_health.main() with sys.argv[1:].

This file is part of a BUSL-1.1-licensed subtree (see
infra/spire/federation/LICENSE-BSL.md). It re-imports
``spire_fed_health`` (BUSL-1.1) and is itself licensed under
BUSL-1.1 for consistency with the imported implementation (ADR-0061,
Schritt 7 Option A).

Kept as a thin shim so the module is import-safe for tests and the
CLI entrypoint is a single line of glue.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Make the sibling module importable without requiring a package layout.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from spire_fed_health import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
