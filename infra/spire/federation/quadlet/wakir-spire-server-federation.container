# SPDX-License-Identifier: BUSL-1.1
# SPDX-FileCopyrightText: 2026 Callandor GmbH and contributors
#
# Phase-2 Sprint-8 Tag-1 — Quadlet unit for the SPIRE-Server-Federation-
# Bundle-Endpoint substrate. This unit is the single-side Quadlet form
# of the compose/spire-federation.yaml substrate; the SAME unit file is
# installed twice (once per trust-domain side) with two different
# bind-mounted config paths and two different host port-publish pairs.
#
# The Quadlet companion exists for atomic-distro hosts (Fedora Atomic /
# Bluefin / Silverblue / Kinoite) that prefer host-native systemd
# integration over ``podman compose up``. The compose surface remains
# the primary Phase-2-Sprint-8 contract (the hermetic test surface in
# infra/spire/federation/tests/ is compose-shape-asserted; the Quadlet
# file is byte-precise mirrored).
#
# This file is the GENERIC Quadlet template — placeholders ``<SIDE>``,
# ``<HOST_BUNDLE_PORT>``, ``<HOST_GRPC_PORT>``, and ``<HOST_BUNDLE_BIND>``
# MUST be substituted by the operator before install. Reference values:
#
#   wakir.test side (hermetic / single-org):
#       SIDE=wakir,   HOST_BUNDLE_PORT=8443, HOST_GRPC_PORT=8082,
#       HOST_BUNDLE_BIND=127.0.0.1
#   partner.test side (hermetic same-host federation):
#       SIDE=partner, HOST_BUNDLE_PORT=8444, HOST_GRPC_PORT=8083,
#       HOST_BUNDLE_BIND=127.0.0.1
#   orbit.test side (Cross-VM Federation Live Trial, Sprint-10 Tag-3):
#       SIDE=orbit,   HOST_BUNDLE_PORT=8443, HOST_GRPC_PORT=8082,
#       HOST_BUNDLE_BIND=0.0.0.0
#
# ``<HOST_BUNDLE_BIND>`` rationale (Sprint-10 Tag-3, M-3 Live-Trial):
#   The bundle-endpoint listener is the ONLY port a federation peer
#   must reach from across a VM boundary. The gRPC API (8081) and any
#   single-org pilot's bundle-endpoint stay loopback-only (127.0.0.1)
#   so an unfederated pilot never exposes its bundle. Cross-VM
#   federation REQUIRES the bundle-endpoint host-bind to be the
#   wildcard (0.0.0.0) so a peer VM can connect over the wakir-
#   federation-internal Proxmox-bridge (or, for the Sprint-10-Tag-3
#   home-LAN dogfood topology, the host's LAN-facing IP).
#   wakir-pilot-bootstrap.sh wires this automatically:
#     * WAKIR_PILOT_MODE=single-org  -> HOST_BUNDLE_BIND=127.0.0.1
#     * WAKIR_PILOT_MODE=federation  -> HOST_BUNDLE_BIND=0.0.0.0
#
# Operator install path (rootful Podman) — wakir side example:
#
#   sed -e 's/<SIDE>/wakir/g' \
#       -e 's/<HOST_BUNDLE_PORT>/8443/g' \
#       -e 's/<HOST_GRPC_PORT>/8082/g' \
#       -e 's/<HOST_BUNDLE_BIND>/127.0.0.1/g' \
#       infra/spire/federation/quadlet/wakir-spire-server-federation.container \
#     | sudo tee /etc/containers/systemd/wakir-spire-server-federation-wakir.container
#   sudo install -m 644 infra/spire/federation/config/spire-server-wakir.conf \
#       /etc/wakir/spire-federation/spire-server-wakir.conf
#   sudo systemctl daemon-reload
#   sudo systemctl start wakir-spire-server-federation-wakir.service
#
# Repeat for the partner side with SIDE=partner, HOST_BUNDLE_PORT=8444,
# HOST_GRPC_PORT=8083, HOST_BUNDLE_BIND=127.0.0.1, and the partner
# config file. For the orbit side in Cross-VM federation, set
# HOST_BUNDLE_BIND=0.0.0.0.
#
# Rootless Podman: copy to ~/.config/containers/systemd/ and use
# ``systemctl --user``; adapt the bind-mount source path to the
# rootless operator's filesystem layout.
#
# Verification (hermetic-by-default — no live-smoke from sandbox per
# feedback_sandbox_host_trennung.md):
#
#   systemctl status wakir-spire-server-federation-<SIDE>.service
#   podman healthcheck run wakir-spire-server-federation-<SIDE>
#
# Tear-down:
#
#   sudo systemctl stop wakir-spire-server-federation-<SIDE>.service
#   podman volume rm wakir-spire-server-federation-<SIDE>-data
#   podman volume rm wakir-spire-server-federation-<SIDE>-sockets
#   podman volume rm wakir-spire-server-federation-<SIDE>-bundles

[Unit]
Description=Wakir Phase-2.1 SPIRE-Server-Federation-Bundle-Endpoint (<SIDE>)
Documentation=https://github.com/wakir-labs/wakir-runtime/blob/main/infra/spire/federation/README.md
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=wakir-spire-server-federation-<SIDE>

# Image pin: mirror of compose/spire-federation.yaml services.spire-
# server-<SIDE>.image. The placeholder ``DIGEST_PENDING_TOMAS_REVIEW``
# resolves to the canonical sha256 digest in the same Operator-Hand
# Cross-Review Zone-C workflow as the Sprint-6 SPIRE-Server image-pin
# (docs/spire-server-phase-2-1.md §2).
Image=ghcr.io/spiffe/spire-server:1.14.6@sha256:DIGEST_PENDING_TOMAS_REVIEW

# Sprint-9-Tag-6 Bug 7 substance-fix: the upstream
# ``ghcr.io/spiffe/spire-server`` image declares
# ``ENTRYPOINT ["/opt/spire/bin/spire-server"]`` and its CMD is empty.
# Quadlet's ``Exec=`` value is APPENDED as positional args (it does
# NOT replace the entrypoint). The previous form ``Exec=run -config
# ...`` produced the effective argv
# ``/opt/spire/bin/spire-server run -config ...`` — which is correct.
# However, on Quadlet versions where the ENTRYPOINT already carries
# the ``run`` subcommand (some derivative images), the result becomes
# ``... run run -config ...`` and SPIRE-Server interprets the second
# ``run`` as a positional arg, ignoring ``-config`` and falling back
# to ``/opt/spire/conf/server/server.conf`` ("could not find config
# file" on live bring-up 2026-05-14). Dropping the explicit ``run``
# token relies on the entrypoint to supply the subcommand and stays
# correct under both image variants.
Exec=-config /etc/spire/server/server.conf

# Bundle-endpoint listener — host bind controlled by <HOST_BUNDLE_BIND>
# (Sprint-10 Tag-3, M-3 Live-Trial). For same-host hermetic test or
# single-org pilot deployments, HOST_BUNDLE_BIND=127.0.0.1 keeps the
# listener loopback-only. For Cross-VM federation (WAKIR_PILOT_MODE=
# federation), HOST_BUNDLE_BIND=0.0.0.0 so a peer VM can fetch the
# bundle over the wakir-federation-internal Proxmox-bridge or the
# host's LAN interface. Operator-Hand substitutes <HOST_BUNDLE_BIND>
# and <HOST_BUNDLE_PORT> at install (the wakir-pilot-bootstrap.sh
# one-shot wires both from WAKIR_PILOT_MODE).
PublishPort=<HOST_BUNDLE_BIND>:<HOST_BUNDLE_PORT>:8443

# SPIRE-Server gRPC API — ALWAYS loopback-only. The gRPC API is the
# privileged control-plane surface (token-generate, agent-list,
# bundle-set); exposing it cross-VM would let any reachable host
# impersonate the operator's hand on the server. Operator-Hand
# substitutes <HOST_GRPC_PORT> to avoid clashing with the
# compose/spire.yaml 8081 mapping or the peer-side federation
# Quadlet's gRPC port.
PublishPort=127.0.0.1:<HOST_GRPC_PORT>:8081

ReadOnly=true
User=1000
Group=1000

# Bind-mount the Mock/Stub config (read-only, SELinux-relabel-private).
# The host-side path encodes the <SIDE> so two-sided install on the
# same host does not clobber.
Volume=/etc/wakir/spire-federation/spire-server-<SIDE>.conf:/etc/spire/server/server.conf:ro,Z

# Named volume sidecars (per-side).
#
# Sprint-9-Tag-8 Bug-20 substance-fix: ``:Z`` SELinux-relabel-private
# is mandatory on FCOS-enforced hosts; without it the named volume
# stays labeled ``root_t`` while the container runs as ``container_t``
# and gets EACCES on first write. Bug-20 was observed as a SPIRE-Agent
# crash-loop on Bring-up-4 (2026-05-14, AR Fred); the server side
# carries the same risk and is fixed prophylactically.
Volume=wakir-spire-server-federation-<SIDE>-data.volume:/var/lib/spire/server:Z,U
Volume=wakir-spire-server-federation-<SIDE>-sockets.volume:/run/spire/sockets:Z,U
Volume=wakir-spire-server-federation-<SIDE>-bundles.volume:/var/lib/spire/bundles:Z,U

# Sprint-9-Tag-6 Bug 12 substance-fix: the previous mode=0700 made
# /run/spire root-only, which blocked the uid:1000 server process
# from creating the gRPC API socket file inside ``/run/spire/sockets``
# (bind-mounted from the per-side ``-sockets.volume``). The agent then
# could not reach the server even on the same host. mode=0755 keeps
# the directory world-readable / owner-writable so the uid:1000
# container user can write the socket node.
Tmpfs=/run/spire:rw,size=16m,mode=0755

# Dedicated federation bridge network (mirror of compose
# spire-federation.yaml). The two Quadlet-instances on the same host
# share this network so each can reach the other's bundle-endpoint at
# the SPIFFE-internal DNS name spire-server-<peer-side>.
#
# Sprint-9-Tag-6 Bug 10 substance-fix: the single-org agent config
# (spire-agent-pilot-single-org.conf) addresses the server via
# ``server_address = "spire-server-wakir"``. The Quadlet ContainerName
# expands to ``wakir-spire-server-federation-<SIDE>`` -- the bare
# ``spire-server-<SIDE>`` short form is NOT a DNS name that Podman
# resolves by default. NetworkAlias registers an additional alias
# inside the federation bridge network so the agent's connect string
# matches both single-org (one-sided) and federation (two-sided) mode.
Network=wakir-federation.network
NetworkAlias=spire-server-<SIDE>

DropCapability=ALL
NoNewPrivileges=true

PodmanArgs=--cpus=0.5 --memory=256m

HealthCmd=/opt/spire/bin/spire-server healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
# Sprint-9-Tag-5 Bug 7 (H3): cold-start CA-init on a slow Pilot-VM can
# exceed 30s. SPIRE-Server first-start does CA-keypair generation +
# datastore SQLite migration + JWT-signing-key setup before the
# healthcheck binary reports ready. 60s gives the cold-start path
# enough headroom; warm restarts are unaffected (the healthcheck
# returns sub-second once the server is up).
HealthStartPeriod=60s

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target default.target
