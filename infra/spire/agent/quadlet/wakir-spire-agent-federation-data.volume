#
# Phase-2 Sprint-8 Tag-2 — Quadlet named-volume template for the
# SPIRE-Agent-Federation data directory. Per-side instance file is
# installed as wakir-spire-agent-<SIDE>-data.volume (sed-substitution
# from this template, mirror of Tag-1 server-side convention).

[Volume]
VolumeName=wakir-spire-agent-<SIDE>-data
