# SPDX-License-Identifier: BUSL-1.1
# SPDX-FileCopyrightText: 2026 Callandor GmbH and contributors
#
# Phase-2 Sprint-8 Tag-2 — Quadlet template for the SPIRE-Agent-Sidecar
# wired into the Tag-1 Federation-Bundle-Endpoint substrate.
#
# This is a TEMPLATE with three placeholders that Operator-Hand
# substitutes at install-time (mirror of the Tag-1
# wakir-spire-server-federation.container template convention):
#
#   <SIDE>             → ``wakir`` or ``partner``
#   <TRUST_DOMAIN>     → ``wakir.test`` or ``partner.test``
#   <SERVER_DNS>       → ``spire-server-wakir`` or ``spire-server-partner``
#
# Install workflow (rootful Podman, per-side):
#
#   # Pre-condition: the Tag-1 SPIRE-Server-federation Quadlet must
#   # already be installed on the same host for the desired side.
#   #
#   # For the wakir.test side:
#   sed -e 's|<SIDE>|wakir|g' \
#       -e 's|<TRUST_DOMAIN>|wakir.test|g' \
#       -e 's|<SERVER_DNS>|spire-server-wakir|g' \
#       quadlet/wakir-spire-agent-federation.container \
#       > /etc/containers/systemd/wakir-spire-agent-wakir.container
#   sed 's|<SIDE>|wakir|g' \
#       quadlet/wakir-spire-agent-federation-data.volume \
#       > /etc/containers/systemd/wakir-spire-agent-wakir-data.volume
#   sed 's|<SIDE>|wakir|g' \
#       quadlet/wakir-spire-agent-federation-sockets.volume \
#       > /etc/containers/systemd/wakir-spire-agent-wakir-sockets.volume
#   sudo install -m 644 config/spire-agent-wakir.conf \
#       /etc/wakir/spire-agent-wakir.conf
#   sudo systemctl daemon-reload
#   sudo systemctl start wakir-spire-agent-wakir.service
#
# Sprint-9-Tag-4 Bug 2/3 note: the source volume files are side-agnostic
# (`wakir-spire-agent-federation-data.volume`); the destination basename
# embeds the side (`wakir-spire-agent-wakir-data.volume`) to match the
# per-side Quadlet VolumeName convention so podman-system-generator
# resolves the Volume= references from this container file.
#
# Tear-down:
#
#   sudo systemctl stop wakir-spire-agent-wakir.service
#   podman volume rm wakir-spire-agent-wakir-data
#   podman volume rm wakir-spire-agent-wakir-sockets
#
# Verification (hermetic-by-default — no live-smoke from sandbox; live
# verification is operator-hand per ADR-0051):
#
#   systemctl status wakir-spire-agent-<SIDE>.service
#   podman healthcheck run wakir-spire-agent-<SIDE>
#   sudo podman exec wakir-spire-agent-<SIDE> \
#       /opt/spire/bin/spire-agent api fetch x509 \
#       -socketPath /run/spire/agent-sockets/api.sock
#
# Image-Pin form (Cosign-Digest-Pin Pfad B, mirror of Tag-1 server
# template): placeholder token ``DIGEST_PENDING_TOMAS_REVIEW`` resolved
# by Operator-Hand before live bring-up (Cross-Review Zone-C,
# Tomás-track).

[Unit]
Description=Wakir Phase-2 Sprint-8 Tag-2 SPIRE-Agent (federation, <SIDE> side)
Documentation=https://github.com/wakir-labs/wakir-runtime/blob/main/infra/spire/agent/README.md
# Sprint-9-Tag-4 Bug 4: the federation server unit is installed as
# ``wakir-spire-server-federation-<SIDE>.service`` (see Tag-1 server
# template + bootstrap step 6c). The agent must depend on the
# ``-federation-`` form, not on the side-only form which corresponds
# to the Sprint-6-Tag-9 single-trust-domain stack.
After=network-online.target wakir-spire-server-federation-<SIDE>.service
Wants=network-online.target
Requires=wakir-spire-server-federation-<SIDE>.service

[Container]
ContainerName=wakir-spire-agent-<SIDE>

# Image pin: byte-precise mirror of compose/spire-agent-federation.yaml
# services.spire-agent-<SIDE>.image. Version-parity with Tag-1
# federation server (SPIRE v1.14.6 — upstream releases server+agent as
# paired binary set).
Image=ghcr.io/spiffe/spire-agent:1.14.6@sha256:DIGEST_PENDING_TOMAS_REVIEW

# Command-line arguments (mirror of compose `command:` list).
#
# Sprint-9-Tag-6 Bug 8 substance-fix: same root cause as Bug 7 on the
# server side -- the upstream ``ghcr.io/spiffe/spire-agent`` image
# declares ``ENTRYPOINT ["/opt/spire/bin/spire-agent"]`` and Quadlet's
# ``Exec=`` value is APPENDED as positional args. The previous form
# ``Exec=run -config ...`` is fine for the upstream image but produces
# ``... run run -config ...`` on derivative images that already carry
# the ``run`` subcommand in their entrypoint. Dropping the explicit
# ``run`` token relies on the entrypoint to supply the subcommand and
# stays correct under both image variants.
#
# Single-org Phase-1b note: the bootstrap injects the join-token via
# in-place sed substitution against the literal ``-joinToken
# WAKIR_JOIN_TOKEN_PLACEHOLDER`` segment below (Bug 1 substance-fix).
# Federation Phase-2.1 leaves the placeholder untouched: federation
# agents re-attest via the peer trust-bundle rather than the join-
# token path. The Quadlet generator strips the trailing token
# placeholder line on a federation install via sed-delete.
Exec=-config /etc/spire/agent/agent.conf -joinToken WAKIR_JOIN_TOKEN_PLACEHOLDER

# Read-only root filesystem (mirror of compose `read_only: true`).
ReadOnly=true

# Run as non-root uid:gid (mirror of compose `user: "1000:1000"`).
User=1000
Group=1000

# Bind-mounts and named volumes (mirror of compose `volumes:` list).
#
# 1) Read-only bind-mount of the per-side Mock/Stub agent config.
Volume=/etc/wakir/spire-agent-<SIDE>.conf:/etc/spire/agent/agent.conf:ro,Z
#
# 2) SPIRE-Agent data directory (bootstrap-trust-bundle cache,
#    federated-bundle cache, SVID cache).
# Sprint-9-Tag-8 Bug-20 substance-fix: ``:Z`` SELinux-relabel-private
# is mandatory on FCOS-enforced hosts; without it the named volume
# stays labeled ``root_t`` while the container runs as ``container_t``
# and gets EACCES on first write. Bug-20 was observed as the SPIRE-
# Agent crash-loop (restart-counter 69+, "directory validation
# failed: permission denied" on /var/lib/spire/agent/.probe) during
# Bring-up-4 on AR-Fred's pilot VM (2026-05-14). Root file of the
# Bring-up-4-cleanup; see PR body and ADR-pending-Tag-8.
Volume=wakir-spire-agent-<SIDE>-data.volume:/var/lib/spire/agent:Z
#
# 3) Federated-bundles ingest (read-only mount of the server-side
#    bundles volume — the Tag-1 server-federation Quadlet creates
#    this volume).
#    Sprint-9-Tag-4 Bug 3: the volume sidecar installed by the
#    bootstrap step 6b is named with the ``-federation-`` mid-token
#    (mirror of the server-side Quadlet VolumeName), not the
#    side-only form. The agent must reference the same Quadlet-source
#    name so the podman-system-generator resolves the volume.
#    Sprint-9-Tag-8 Bug-20: ``:ro,Z`` — Z is the SELinux-relabel
#    flag, ro the read-only flag. Order is irrelevant to Podman but
#    matches the bind-mount style above for readability.
Volume=wakir-spire-server-federation-<SIDE>-bundles.volume:/var/lib/spire/bundles:ro,Z
#
# 4) Workload-API socket — agents serve the SPIFFE-Workload-API on
#    this volume. Phase-2.3+ persona-containers mount this volume
#    read-only at the same path; the `spiffe.workload_api` client
#    targets `unix:///run/spire/agent-sockets/api.sock`.
Volume=wakir-spire-agent-<SIDE>-sockets.volume:/run/spire/agent-sockets:Z

# tmpfs for ephemeral SPIRE runtime paths (parity with server).
#
# Sprint-9-Tag-6 Bug 12 substance-fix: the previous mode=0700 made
# /run/spire root-only, which blocked the uid:1000 agent process
# from creating the Workload-API socket file inside
# ``/run/spire/agent-sockets``. Persona workloads then could not
# reach the agent even on the same host. mode=0755 keeps the
# directory world-readable / owner-writable so the uid:1000 container
# user can write the socket node.
Tmpfs=/run/spire:rw,size=16m,mode=0755

# Federation bridge network (external, owned by Tag-1 Quadlet).
Network=wakir-federation.network

# Container-init hardening (parity with Tag-1 server template +
# Sprint-6-Tag-9 agent).
DropCapability=ALL
NoNewPrivileges=true

# Resource envelope (mirror of compose `deploy.resources.limits`).
PodmanArgs=--cpus=0.5 --memory=256m

# Health probe (mirror of compose healthcheck:). SPIRE-Agent
# healthcheck subcommand.
HealthCmd=/opt/spire/bin/spire-agent healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
# Sprint-9-Tag-5 Bug 7 (H3): SPIRE-Agent cold-start waits for the
# server's gRPC API to become reachable AND completes the join-token
# attestation handshake before the healthcheck binary reports ready.
# On a cold Pilot-VM the server itself needs ~30-40s to come up;
# 60s on the agent side gives the attestation handshake additional
# headroom on top of that.
HealthStartPeriod=60s

[Service]
# Restart policy: compose `restart: unless-stopped` -> on-failure.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target default.target
