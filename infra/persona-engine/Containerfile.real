#
# wakir-persona-engine REAL — Sprint-Pengine-8, image tag ``0.2.0-pilot``.
#
# Substrate scope (0.2.0-pilot)
# -----------------------------
# Real-implementation image. Drops in for the substrate-stub
# ``0.1.0-pilot`` image via Quadlet tag-pin rotation (the
# resolve-image-pins-ci substitution path closes the swap idempotently).
#
# Tag-rotation pattern (Selin Sprint-Pengine-8 axis):
#
#   1. Operator runs ``gh workflow run build-wakir-persona-engine.yml``
#      with input ``version_tag=0.2.0-pilot`` and Containerfile path
#      pointing at this file (Containerfile.real).
#   2. GHCR receives the new digest under
#      ``ghcr.io/wakir-labs/wakir-persona-engine:0.2.0-pilot``.
#   3. Operator opens a Quadlet-pin-rotation PR updating
#      ``quadlet/wakir-persona-tomas.container`` Image= line tag
#      from ``0.1.0-pilot`` to ``0.2.0-pilot``.
#   4. ``resolve-image-pins-ci`` workflow fills the
#      ``@sha256:DIGEST_PENDING_*`` placeholder with the live digest.
#   5. Operator-Hand-systemctl-restart on the Pilot-VM picks up the
#      new image. Engine-swap complete.
#
# Why a separate Containerfile
# ----------------------------
# Containerfile (the original, Sprint-10 Tag-4) ships the stub binary
# only. Containerfile.real ships the wakir-runtime tree slice that
# carries ``wirelang.persona_engine`` plus the thin shim entry-point
# ``persona-engine-real``. The two Containerfiles share the python:3.13-
# slim base; only the COPY tree differs. Split-by-file (rather than
# build-arg switching) keeps the supply-chain provenance clear: each
# tag corresponds to exactly one Containerfile.

FROM docker.io/library/python:3.13-slim@sha256:DIGEST_PENDING_TOMAS_REVIEW

# OCI metadata.
LABEL org.opencontainers.image.title="wakir-persona-engine"
LABEL org.opencontainers.image.description="Runtime image for the Wakir persona-engine real binary (Sprint-Pengine-8, v0.2.0-pilot; full lifecycle FSM, V-907 pin verify, SPIFFE workload-API probe, bridge-audit double-sink, R1..R4 recovery, P1..P4 despawn-clean)."
LABEL org.opencontainers.image.version="0.2.0-pilot"
LABEL org.opencontainers.image.licenses="BUSL-1.1"
LABEL org.opencontainers.image.source="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.url="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.documentation="https://github.com/wakir-labs/wakir-runtime/blob/main/infra/persona-engine/README.md"

# Non-root runtime user (parity with 0.1.0-pilot + SPIRE-Agent + NATS).
RUN groupadd --gid 1000 wakir \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin wakir \
    && mkdir -p /opt/wakir/bin \
    && chown -R 1000:1000 /opt/wakir

# Ship the real-engine entrypoint shim and symlink it to
# ``persona-engine`` so the Quadlet Exec= line is byte-stable across
# the stub-to-real swap.
COPY --chown=1000:1000 bin/persona-engine-real /opt/wakir/bin/persona-engine-real
RUN chmod 0755 /opt/wakir/bin/persona-engine-real \
    && ln -s /opt/wakir/bin/persona-engine-real /opt/wakir/bin/persona-engine

USER 1000:1000
WORKDIR /opt/wakir-runtime

# Entrypoint: the symlinked persona-engine resolves to the real shim;
# the Quadlet Exec=spawn --persona-slug tomas... line is byte-stable.
ENTRYPOINT ["/opt/wakir/bin/persona-engine"]
