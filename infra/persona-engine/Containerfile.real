#
# wakir-persona-engine REAL — Sprint-Pengine-10, image tag ``0.4.0-pilot``.
#
# Substrate scope (0.4.0-pilot)
# -----------------------------
# Sprint-Pengine-10 closes the input-side gap discovered during the
# 0.3.0-pilot Live-Engine-Swap (only heartbeat + spawn-init audit, no
# task-input plumbing). 0.4.0-pilot wires:
#
#   - OI-PEFR-6: real NATS-subscribe-loop on
#     ``wakir.<env>.agent.agent.task.assigned.<persona-slug>``;
#     per-message dispatch to the LlmCallHook with bridge-audit
#     reply emission + companion-subject output publish.
#   - OI-PEFR-7: ``wakir-mira-dispatch`` Side-CLI that mirrors Mira's
#     engineering Auftrag onto the Bridge-Forward-Pipe.
#   - OI-PEFR-8: Phase-2-Stub LLM-Call-Shim ``EchoReflectionLlmHook``
#     (deterministic echo responder; Phase-3 swap-point preserved
#     via ``anthropic_messages_hook_phase_3_stub``).
#   - OI-PEFR-9: ``wakir-doppelbetrieb-aggregate`` CLI for weekly
#     4-axis Bilanz (ADR-0058 §Pilot-Phase Schritt 10).
#
# Sprint-Pengine-9 closed substrate-gaps OI-PEFR-1..5; this image is a
# strict superset of 0.3.0-pilot — every code path the stub + 0.2.0
# + 0.3.0 consumed remains reachable. Quadlet tag-rotation (operator-
# hand) covers the 0.3.0-pilot -> 0.4.0-pilot swap.
#
# Tag-rotation pattern
# --------------------
#
#   1. Operator runs ``gh workflow run build-wakir-persona-engine.yml``
#      with input ``version_tag=0.4.0-pilot`` and
#      ``containerfile=Containerfile.real``.
#   2. GHCR receives the new digest under
#      ``ghcr.io/wakir-labs/wakir-persona-engine:0.4.0-pilot``.
#   3. Operator opens a Quadlet-pin-rotation PR updating
#      ``quadlet/wakir-persona-tomas.container`` Image= line tag
#      from ``0.3.0-pilot`` to ``0.4.0-pilot``.
#   4. ``resolve-image-pins-ci`` workflow fills the
#      ``@sha256:DIGEST_PENDING_*`` placeholder with the live digest.
#   5. Operator-Hand-systemctl-restart on the Pilot-VM picks up the
#      new image. Engine-swap complete.
#
# Wheel substrate (Bug-34c structural fix, Sprint-Pengine-9)
# ----------------------------------------------------------
# Prior 0.2.0-pilot installed wheels via a flat ``RUN pip install
# 'rfc8785>=0.1.4' 'PyYAML>=6.0' 'shamir-mnemonic>=0.3.0' 'cryptography>=42'``
# layer (Mira-Hand PRs #66 + #68 to chase ModuleNotFoundError-at-boot).
# That layer drifts every time a new transitive dep lands; the
# structural fix is the ``[project.optional-dependencies]
# persona-engine-runtime`` extra in pyproject.toml. This Containerfile
# COPYs the repo tree and runs ``pip install '/opt/wakir-runtime/.
# [persona-engine-runtime]'`` once. Adding a new runtime dep (e.g. a
# future opentelemetry-sdk pin from Noa) becomes a pyproject.toml
# edit, not a Containerfile RUN-layer rewrite.

FROM docker.io/library/python:3.13-slim@sha256:DIGEST_PENDING_TOMAS_REVIEW

# OCI metadata.
LABEL org.opencontainers.image.title="wakir-persona-engine"
LABEL org.opencontainers.image.description="Runtime image for the Wakir persona-engine real binary (Sprint-Pengine-12, v0.4.2-pilot; CLI-async-wrap with auto subscribe-loop activation on WAKIR_SUBSCRIBE_ENV, NATS-KV asyncio state-backing, gRPC SPIFFE Workload-API SVID-fetch with graceful-fallback to socket-probe-only on Bug-40 wire-error, async engine wrapper with NATS-subscribe-loop + SVID-refetch background-task, Phase-2-Stub LLM-Call-Shim, Bridge-Forward-Pipe input plumbing)."
LABEL org.opencontainers.image.version="0.4.2-pilot"
LABEL org.opencontainers.image.licenses="BUSL-1.1"
LABEL org.opencontainers.image.source="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.url="https://github.com/wakir-labs/wakir-runtime"
LABEL org.opencontainers.image.documentation="https://github.com/wakir-labs/wakir-runtime/blob/main/infra/persona-engine/README.md"

# Non-root runtime user (parity with 0.2.0-pilot + SPIRE-Agent + NATS).
RUN groupadd --gid 1000 wakir \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin wakir \
    && mkdir -p /opt/wakir/bin /opt/wakir-runtime \
    && chown -R 1000:1000 /opt/wakir /opt/wakir-runtime

# Copy the wakir-runtime tree into the image so the persona-engine
# extra can resolve the wirelang package + setuptools-package-data
# fixtures. The COPY order is deliberate: pyproject.toml + the setup
# closure first (this caches the wheel-install layer when only
# wirelang source changes), then the source tree.
COPY --chown=1000:1000 pyproject.toml /opt/wakir-runtime/pyproject.toml
COPY --chown=1000:1000 README.md      /opt/wakir-runtime/README.md
COPY --chown=1000:1000 LICENSE        /opt/wakir-runtime/LICENSE
COPY --chown=1000:1000 NOTICE         /opt/wakir-runtime/NOTICE
COPY --chown=1000:1000 wirelang/      /opt/wakir-runtime/wirelang/
COPY --chown=1000:1000 wat/           /opt/wakir-runtime/wat/

# Sprint-Pengine-9 Bug-34c structural fix: install the wakir-runtime
# package + the persona-engine-runtime extra in one invocation.
# ``--no-cache-dir`` keeps the image slim; ``--no-deps`` would skip
# transitive wheels (we keep the default; the extra is closed).
RUN pip install --no-cache-dir '/opt/wakir-runtime/.[persona-engine-runtime]'

# Ship the real-engine entrypoint shim and symlink it to
# ``persona-engine`` so the Quadlet Exec= line is byte-stable across
# the stub-to-real swap.
COPY --chown=1000:1000 infra/persona-engine/bin/persona-engine-real /opt/wakir/bin/persona-engine-real
RUN chmod 0755 /opt/wakir/bin/persona-engine-real \
    && ln -sf /opt/wakir/bin/persona-engine-real /opt/wakir/bin/persona-engine

USER 1000:1000
WORKDIR /opt/wakir-runtime

# Entrypoint: the symlinked persona-engine resolves to the real shim;
# the Quadlet Exec=spawn --persona-slug tomas... line is byte-stable.
ENTRYPOINT ["/opt/wakir/bin/persona-engine"]
